{
  "name": "affl-history",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "fetch": "node scripts/fetch-espn.mjs",
    "fetch:force": "node scripts/fetch-espn.mjs --force",
    "data": "node scripts/build-data.mjs",
    "boxscores": "node scripts/build-boxscores.mjs",
    "transactions": "node scripts/build-transactions.mjs",
    "player-ages": "node scripts/fetch-player-ages.mjs",
    "roster-age": "node scripts/build-roster-age.mjs",
    "refresh": "node scripts/fetch-espn.mjs && node scripts/build-data.mjs && node scripts/build-boxscores.mjs && node scripts/build-transactions.mjs && node scripts/fetch-player-ages.mjs && node scripts/build-roster-age.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "^5.0.13",
    "@fontsource/inter": "^5.0.18",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^6.0.1"
  }
}
